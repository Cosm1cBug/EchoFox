# ─── Never ship to the image ──────────────────────────────────────────────
node_modules
npm-debug.log*

# Dashboard build inputs: dependencies and build output are produced
# inside the image by the dashbuilder stage, so never ship the host
# copies (a host node_modules would also break `npm ci` there).
dashboard/node_modules
dashboard/dist
dashboard/*.tsbuildinfo

# ─── Secrets / user data ──────────────────────────────────────────────────
src/config.js
src/@session
src/store/runtime
src/store/*.db
src/store/*.db-*
.env
.env.*
!.env.example

# ─── VCS & CI noise ───────────────────────────────────────────────────────
.git
.gitignore
.gitattributes
.github
.husky
.editorconfig
.prettier*
.eslint*

# ─── Local-only development files ─────────────────────────────────────────
coverage
.nyc_output
logs
*.log
.vscode
.idea
.DS_Store
Thumbs.db

# ─── Build artefacts ──────────────────────────────────────────────────────
dist
build

# ─── Docs (kept out of runtime image to slim it; mounted on docs site) ────
docs
UPGRADE.md
CHANGELOG.md
CONTRIBUTING.md

# ─── Disabled / broken commands shouldn't ship ────────────────────────────
src/commands/_disabled

# ─── Docker self-reference (would be wasteful) ────────────────────────────
Dockerfile
docker-compose*.yml
docker

# Fresh-source session credentials and external runtime data
data/

# Operator-provisioned secret mounts must not enter image layers
secrets/

# Credentials and backup archives under custom source paths
**/creds.json
**/pre-key-*.json
**/session-*.json
**/sender-key-*.json
**/app-state-sync-key-*.json
**/*.tar.gz*
**/*.tgz

# Default external configuration may contain credentials
echofox.config.*
